# ============================================================
#  Qué NO se sube
#
#  El repositorio es privado, pero "privado" no es lo mismo que
#  "seguro": lo ve todo el que tenga acceso al repo, y queda en el
#  historial para siempre aunque después se borre el archivo.
# ============================================================

.DS_Store
*.log
node_modules/
.vercel/

